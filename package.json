{
  "name": "@gitlab-ui-react/monorepo",
  "private": true,
  "description": "",
  "scripts": {
    "dev": "storybook dev -p 6006 --config-dir apps/storybook",
    "build": "pnpm --filter @gitlab-ui-react/styles... build",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:watch": "vitest --project=storybook",
    "playwright:install": "playwright install chromium",
    "tokens:build": "pnpm --filter @gitlab-ui-react/tokens build",
    "styles:build": "pnpm --filter @gitlab-ui-react/styles build",
    "ui:build": "pnpm --filter gitlab-ui-react build",
    "website:dev": "pnpm --filter website dev",
    "website:check": "pnpm --filter website check",
    "website:build": "pnpm --filter website build",
    "storybook:build": "storybook build --config-dir apps/storybook -o apps/storybook/build",
    "scaffold": "node scripts/scaffold-component.mjs",
    "scaffold:validate": "node scripts/validate-component.mjs",
    "upstream": "node scripts/upstream-baseline.mjs",
    "changeset": "changeset",
    "release:changeset": "node scripts/create-changeset.mts",
    "release:version": "node scripts/version.mts",
    "release:prepare": "node scripts/publish.mts --prepare-only",
    "release:publish": "node scripts/publish.mts"
  },
  "keywords": [],
  "author": "NriotHrreion",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@gitlab/ui": "^137.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "lodash-es": "4.18.1",
    "oxlint": "^1.80.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.0",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
