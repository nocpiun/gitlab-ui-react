{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.2.8"
    }
  },
  "ignorePatterns": [
    "**/dist/**",
    "oxlint-plugins/fixtures/**"
  ],
  "plugins": [
    "typescript",
    "react",
    "import",
    "jsx-a11y"
  ],
  "jsPlugins": [
    "@stylistic/eslint-plugin",
    {
      "name": "react-js",
      "specifier": "eslint-plugin-react"
    },
    {
      "name": "import-js",
      "specifier": "eslint-plugin-import"
    },
    {
      "name": "gitlab-ui-react",
      "specifier": "./oxlint-plugins/prefer-clsx.mjs"
    }
  ],
  "overrides": [
    {
      "files": ["**/*.{js,mjs,ts,tsx}"],
      "rules": {
        "no-array-constructor": "error",
        "no-unused-expressions": "off",
        "no-unused-vars": ["error", {
          "args": "none",
          "caughtErrors": "none"
        }],
        "react/display-name": "off",
        "react/jsx-key": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-target-blank": "error",
        "react/jsx-no-undef": "error",
        "react/no-children-prop": "off",
        "react/no-danger-with-children": "error",
        "react/no-direct-mutation-state": "error",
        "react/no-find-dom-node": "error",
        "react/no-is-mounted": "error",
        "react/no-render-return-value": "error",
        "react/no-string-refs": "error",
        "react/no-unescaped-entities": "error",
        "react/no-unknown-property": "error",
        "react/no-unsafe": "off",
        "react/react-in-jsx-scope": "off",
        "import/first": "error",
        "import/no-duplicates": "error",
        "import/no-named-as-default": "off",
        "arrow-body-style": ["error", "as-needed"],
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-activedescendant-has-tabindex": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/autocomplete-valid": "error",
        "jsx-a11y/html-has-lang": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/lang": "error",
        "jsx-a11y/no-access-key": "error",
        "jsx-a11y/no-aria-hidden-on-focusable": "error",
        "jsx-a11y/no-distracting-elements": "error",
        "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
        "jsx-a11y/no-redundant-roles": "error",
        "jsx-a11y/scope": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        "typescript/ban-ts-comment": "error",
        "typescript/no-duplicate-enum-values": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "off",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-misused-new": "error",
        "typescript/no-namespace": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-this-alias": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-declaration-merging": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-namespace-keyword": "error",
        "typescript/triple-slash-reference": "error",
        "typescript/consistent-type-imports": "warn",
        "@stylistic/keyword-spacing": ["error", {
          "after": true,
          "overrides": {
            "if": { "after": false },
            "for": { "after": false },
            "while": { "after": false },
            "switch": { "after": false },
            "with": { "after": false }
          }
        }],
        "@stylistic/brace-style": ["error", "1tbs", { "allowSingleLine": true }],
        "@stylistic/implicit-arrow-linebreak": ["error", "beside"],
        "@stylistic/nonblock-statement-body-position": ["error", "beside"],
        "@stylistic/semi": ["error", "always"],
        "@stylistic/quotes": ["error", "double"],
        "@stylistic/arrow-parens": ["error", "always"],
        "react-js/jsx-closing-bracket-location": ["error", "after-props"],
        "react-js/jsx-closing-tag-location": ["error", "tag-aligned"],
        "react-js/jsx-uses-vars": "error",
        "react-js/no-deprecated": "error",
        "react-js/prop-types": "error",
        "react-js/require-render-return": "error",
        "import-js/order": ["warn", {
          "groups": [
            "type",
            "builtin",
            "external"
          ],
          "newlines-between": "ignore"
        }],
        "gitlab-ui-react/prefer-clsx": "warn",
      }
    }
  ]
}
