{
  "name": "gitlab-ui-react",
  "version": "0.0.0",
  "description": "GitLab UI components for React",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/nocpiun/gitlab-ui-react.git",
    "directory": "packages/ui"
  },
  "homepage": "https://glui.nocp.space",
  "bugs": "https://github.com/nocpiun/gitlab-ui-react/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    "./*": {
      "types": "./dist/base/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json"
  },
  "keywords": [],
  "author": "NriotHrreion",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@gitlab/svgs": "^3.163.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "dompurify": "3.4.14",
    "emoji-regex": "10.6.0"
  }
}
