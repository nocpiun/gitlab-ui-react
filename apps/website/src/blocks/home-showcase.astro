---
import { BookingBlock } from "./booking-block";
import { CheckoutBlock } from "./checkout-block";
import { InventoryBlock } from "./inventory-block";
import { PlansBlock } from "./plans-block";
import { SecurityBlock } from "./security-block";
import { SupportBlock } from "./support-block";
import { TasksBlock } from "./tasks-block";
import { TravelPlanBlock } from "./travel-plan-block";
---

<section class="showcase" aria-label="Interface examples for different products">
  <div class="showcase-grid">
    <div class="showcase-item showcase-item-checkout">
      <CheckoutBlock client:visible />
    </div>
    <div class="showcase-item showcase-item-travel">
      <TravelPlanBlock client:visible />
    </div>
    <div class="showcase-item showcase-item-booking">
      <BookingBlock />
    </div>
    <div class="showcase-item showcase-item-tasks">
      <TasksBlock client:visible />
    </div>
    <div class="showcase-item showcase-item-support">
      <SupportBlock />
    </div>
    <div class="showcase-item showcase-item-inventory">
      <InventoryBlock />
    </div>
    <div class="showcase-item showcase-item-security">
      <SecurityBlock client:visible />
    </div>
    <div class="showcase-item showcase-item-plans">
      <PlansBlock />
    </div>
  </div>
</section>

<style>
  .showcase {
    position: relative;
    height: 73rem;
    overflow: hidden;
    padding: var(--gl-spacing-scale-10);
  }

  .showcase::after {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    height: 24rem;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--gl-background-color-default) 72%, transparent) 38%,
      var(--gl-background-color-default) 92%
    );
    content: "";
    pointer-events: none;
  }

  .showcase-grid {
    max-width: 96rem;
    margin: 0 auto;
    column-count: 4;
    column-gap: var(--gl-spacing-scale-6);
  }

  .showcase-item {
    display: inline-block;
    width: 100%;
    margin-bottom: var(--gl-spacing-scale-6);
    break-inside: avoid;
    vertical-align: top;
  }

  @media (max-width: 74.99rem) {
    .showcase {
      height: 108rem;
    }

    .showcase-grid {
      column-count: 2;
    }
  }

  @media (max-width: 47.99rem) {
    .showcase {
      height: 116rem;
      padding-right: var(--gl-spacing-scale-5);
      padding-left: var(--gl-spacing-scale-5);
    }

    .showcase-grid {
      column-count: 1;
    }

    .showcase-item {
      margin-bottom: var(--gl-spacing-scale-5);
    }
  }
</style>
