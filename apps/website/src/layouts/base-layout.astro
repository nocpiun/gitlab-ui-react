---
import { ClientRouter } from "astro:transitions";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import "../styles/global.css";
import { Navbar } from "../components/navbar";
import { Footer } from "../components/footer";
import { languageTags, localeSwitchPath, localizedPath, type Locale } from "../i18n/config";
import { siteMessages } from "../i18n/messages";
import { docsSearchInstance } from "../search";

interface Props {
  alternatePaths: Partial<Record<Locale, string>>;
  locale: Locale;
  title: string;
  description?: string;
}

const {
  alternatePaths,
  locale,
  title,
  description = "GitLab UI for React",
} = Astro.props;
const switchPath = localeSwitchPath(locale, alternatePaths);
const searchInstance = docsSearchInstance(locale);
---

<!doctype html>
<html lang={languageTags[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {alternatePaths.en && (
      <link rel="alternate" hreflang="en" href={new URL(alternatePaths.en, Astro.site)} />
    )}
    {alternatePaths.zh && (
      <link rel="alternate" hreflang="zh-CN" href={new URL(alternatePaths.zh, Astro.site)} />
    )}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternatePaths.en ?? localizedPath("en"), Astro.site)}
    />
    <script is:inline>
      (() => {
        const applyStoredTheme = () => {
          try {
            const storedTheme = localStorage.getItem("gitlab-ui-react-theme");
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            const isDark = storedTheme === "dark" || (storedTheme === null && prefersDark);

            document.documentElement.classList.toggle("gl-dark", isDark);
            document.documentElement.dataset.pfTheme = isDark ? "dark" : "light";
            document.documentElement.style.colorScheme = isDark ? "dark" : "light";
          } catch {
            // Keep the default light theme when browser storage is unavailable.
          }
        };

        document.addEventListener("astro:after-swap", applyStoredTheme);
        applyStoredTheme();
      })();
    </script>
    <ClientRouter />
  </head>

  <body class="flex min-h-[100dvh] flex-col">
    <PagefindConfig instance={searchInstance} lang={languageTags[locale]} />
    <pagefind-modal class="site-search-modal" instance={searchInstance} reset-on-close>
      <pagefind-modal-header>
        <pagefind-input
          instance={searchInstance}
          placeholder={siteMessages[locale].navbar.searchPlaceholder}
        />
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary instance={searchInstance} />
        <pagefind-results instance={searchInstance} max-sub-results="3" />
      </pagefind-modal-body>
      <pagefind-modal-footer>
        <pagefind-keyboard-hints instance={searchInstance} />
      </pagefind-modal-footer>
    </pagefind-modal>

    <Navbar
      client:only="react"
      transition:persist="site-navbar"
      locale={locale}
      localeSwitchPath={switchPath}
    />

    <main class="min-w-0 flex-1" id="main-content">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>

<script>
  import { locales } from "../i18n/config";
  import { docsSearchInstance } from "../search";

  type PagefindComponentsWindow = Window & {
    PagefindComponents?: {
      getInstanceManager(): {
        removeInstance(name: string): void;
      };
    };
  };

  document.addEventListener("astro:before-swap", () => {
    const manager = (window as PagefindComponentsWindow).PagefindComponents?.getInstanceManager();

    for(const locale of locales) manager?.removeInstance(docsSearchInstance(locale));
  });

  document.addEventListener("click", (event) => {
    if(!(event.target instanceof Element)) return;

    const resultLink = event.target.closest("pagefind-results a");
    const modal = resultLink?.closest<HTMLElement & { close(): void }>("pagefind-modal");

    modal?.close();
  });
</script>
