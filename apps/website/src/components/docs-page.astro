---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { GlIcon } from "gitlab-ui-react/icon";
import { GlMarkdown } from "gitlab-ui-react/markdown";
import { DocsCodeBlockCopyButtons } from "./docs-code-block-copy-buttons";
import LlmFriendlyCard from "./llm-friendly-card.astro";
import { DocsNavigation } from "./docs-navigation";
import { DocsTableOfContents } from "./docs-table-of-contents";
import { localizedDocsComponents } from "./localized-docs-components";
import type { Locale } from "../i18n/config";
import { docsMarkdownPath } from "../llm";
import { siteMessages } from "../i18n/messages";
import BaseLayout from "../layouts/base-layout.astro";

interface Props {
  alternatePaths: Partial<Record<Locale, string>>;
  currentId: string;
  entry: CollectionEntry<"docs">;
  locale: Locale;
}

const { alternatePaths, currentId, entry, locale } = Astro.props;
const { Content, headings } = await render(entry);
const messages = siteMessages[locale];
const tableOfContents = headings.filter(({ depth }) => depth >= 2 && depth <= 3);
const mdxComponents = localizedDocsComponents(locale);
const markdownPath = docsMarkdownPath(locale, currentId);
---

<BaseLayout
  alternatePaths={alternatePaths}
  description={entry.data.description ?? entry.data.title}
  locale={locale}
  markdownPath={markdownPath}
  title={entry.data.title + " · GitLab UI React"}>
  <div>
    <div class="mx-6 sm:mx-8 lg:mx-12 xl:mx-16 2xl:mx-28">
      <div class="mx-auto w-full max-w-[96rem]">
        <div class="docs-layout-grid grid min-[1200px]:grid-cols-[15.75rem_minmax(0,1fr)]">
          <aside class="min-[1200px]:sticky min-[1200px]:top-0 min-[1200px]:max-h-[100dvh] min-[1200px]:self-start min-[1200px]:overflow-x-hidden min-[1200px]:overflow-y-auto min-[1200px]:py-8 min-[1200px]:ps-3">
            <DocsNavigation
              client:load
              transition:persist="docs-navigation"
              currentId={currentId}
              locale={locale}
            />
          </aside>

          <article class="min-w-0 py-8 max-md:pt-6 sm:px-6 sm:py-8 md:px-8 lg:px-10 lg:py-10 xl:px-12" data-pagefind-body>
            <GlMarkdown className="docs-content mx-auto max-w-3xl">
              <header class="mb-6">
                <h1 data-pagefind-meta="title">{entry.data.title}</h1>
                {entry.data.description && (
                  <p class="mt-3 text-subtle text-lg">{entry.data.description}</p>
                )}
              </header>
              {tableOfContents.length > 0 && (
                <details class="group mb-4 rounded-lg border border-section bg-subtle p-3 min-[1360px]:hidden" data-pagefind-ignore="all">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-md px-2 py-1 font-semibold text-heading marker:content-none focus-visible:outline-2 focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden">
                    {messages.docs.tableOfContents.title}
                    <GlIcon
                      className="shrink-0 transition-transform group-open:rotate-90"
                      name="chevron-right" />
                  </summary>
                  <DocsTableOfContents
                    client:load
                    className="px-2 pt-3"
                    headings={tableOfContents}
                    locale={locale}
                    showTitle={false}
                  />
                </details>
              )}
              <LlmFriendlyCard
                className="mb-8 min-[1360px]:hidden"
                href={markdownPath}
                locale={locale}
              />
              <Content components={mdxComponents} />
            </GlMarkdown>
            <DocsCodeBlockCopyButtons client:load locale={locale} />
          </article>

          <aside class="hidden px-5 py-8 min-[1360px]:block">
            <div class="sticky top-8 max-h-[calc(100dvh-4rem)] overflow-y-auto">
              <DocsTableOfContents
                client:load
                headings={tableOfContents}
                locale={locale}
              />
              <LlmFriendlyCard className="mt-6" href={markdownPath} locale={locale} />
            </div>
          </aside>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @media (min-width: 1360px) {
    .docs-layout-grid {
      grid-template-columns: 15.75rem minmax(0, 1fr) 14rem;
    }
  }

  .docs-content {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .docs-content :is(h2, h3) {
    scroll-margin-top: 2rem;
  }

  .docs-content :is(img, video) {
    max-width: 100%;
    height: auto;
  }

  .docs-content :is(pre, table) {
    max-width: 100%;
  }

  .docs-content table {
    display: block;
    overflow-x: auto;
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    if(!(event.target instanceof Element)) return;

    const toggle = event.target.closest("[data-docs-example-toggle]");
    if(!(toggle instanceof HTMLButtonElement)) return;

    const example = toggle.closest("[data-docs-example]");
    const component = example?.querySelector<HTMLElement>("[data-docs-example-component]");
    const source = example?.querySelector<HTMLElement>("[data-docs-example-source]");
    if(!component || !source) return;

    const showSource = source.hidden;
    source.hidden = !showSource;
    toggle.setAttribute("aria-pressed", String(showSource));

    const hideLabel = toggle.dataset.docsExampleHideLabel;
    const showLabel = toggle.dataset.docsExampleShowLabel;
    const nextLabel = showSource ? hideLabel : showLabel;
    if(nextLabel) toggle.setAttribute("aria-label", nextLabel);
  });
</script>
