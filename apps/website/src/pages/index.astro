---
import { GlButton } from "gitlab-ui-react";
import HomeShowcase from "../blocks/home-showcase.astro";
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="GitLab UI React">
  <div class="min-h-75 mx-10 my-4 rounded-3xl bg-linear-30 from-brand-orange-01p via-brand-orange-01g via-60% to-brand-purple-01g flex flex-col justify-center items-center">
    <h1 class="text-[5rem] text-center font-[700] dark:text-white!">
      Bringing GitLab's UI to React.
    </h1>

    <p class="mt-5! text-[2rem] font-semibold text-center dark:text-white!">
      GitLab Pajamas UI for React
    </p>

    <div class="mt-10 flex gap-4">
      <GlButton variant="confirm" className="dark:bg-white! dark:text-black!">
        Get Started
      </GlButton>
      <GlButton className="border-none! dark:bg-black! dark:text-white!">
        Browse Components
      </GlButton>
    </div>
  </div>

  <HomeShowcase />
</BaseLayout>
