---
import { getCollection } from "astro:content";
import DocsPage from "../../../components/docs-page.astro";
import { docsStaticPaths } from "../../../i18n/docs";

export async function getStaticPaths() {
  return docsStaticPaths(await getCollection("docs"), "zh");
}

const { alternatePaths, currentId, entry } = Astro.props;
---

<DocsPage
  alternatePaths={alternatePaths}
  currentId={currentId}
  entry={entry}
  locale="zh"
/>
